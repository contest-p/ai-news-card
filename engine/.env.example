# Engine only. Copy to .env; never put this key in frontend code.
# Fill in the CHAT key from Codyssey, not an IMAGE key.
OPENAI_API_KEY=
# Set the exact API base URL from Codyssey's documentation.
# This is intentionally blank; do not assume the OpenAI public endpoint.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.5

# Test mail only. Use provider-issued credentials; never commit the filled .env.
SMTP_HOST=
SMTP_PORT=
# ssl (usually 465) or starttls (usually 587); use your provider's settings.
SMTP_SECURITY=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TEST_TO=

# Card image renderer. Optional: defaults to an OS Korean font (Windows Noto Sans KR,
# Ubuntu fonts-nanum). GitHub Actions should set this explicitly.
CARD_FONT_PATH=
# Optional: Chrome/Edge path; otherwise Playwright's bundled Chromium is used.
CARD_BROWSER_PATH=

# Engine DB/API connection. Browser login tokens are not used here.
ENGINE_FIREBASE_PROJECT=ai-news-card
# Optional service-account key outside the repository. Leave blank to use ADC.
FIREBASE_SERVICE_ACCOUNT_KEY=
# Exact engine API prefix supplied by Backend, e.g. https://host/api/v1/engine.
# The proposed contract is in docs/firebase/ENGINE_API_CONTRACT.md.
ENGINE_API_BASE_URL=
ENGINE_API_TOKEN=
ENGINE_WEB_BASE_URL=
# A real test subscription whose recipient_email exactly equals SMTP_TEST_TO.
ENGINE_TEST_SUBSCRIPTION_ID=
# Agree on 1..30 days with Backend before enabling live test archive storage.
ENGINE_ARCHIVE_RETENTION_DAYS=
