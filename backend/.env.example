# Server-only settings. Existing service-account keys or local ADC are supported.
FIREBASE_PROJECT_ID=ai-news-card
FIREBASE_SERVICE_ACCOUNT_KEY=
# Hosting secret: full service-account JSON. Never put this in frontend settings.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Random server-to-server token, >=32 chars; set the same value in engine/.env.
ENGINE_API_TOKEN=
# Independent signing secret. Keep stable while issued feedback tokens are valid.
FEEDBACK_TOKEN_SECRET=
# Default team collection. For isolated checks use engine_test_subscriptions.
ENGINE_SUBSCRIPTIONS_COLLECTION=subscriptions
# Comma-separated deployed frontend origins; local 5500/5501 are already allowed.
FRONTEND_ORIGINS=
CONSENT_VERSION=v1

# Only categories approved by source QA. Empty until approval; do not enable all automatically.
PUBLIC_CATEGORIES=
